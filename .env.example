# --- LLM (OpenAI-mos API; bittasini tanlang, qolganlarini izohda qoldiring) ---
# 1) Groq (bepul tarif, OpenAI ochiq modeli) — tavsiya etiladi:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-20b

# 2) Ollama (lokal, bepul, kalit kerak emas):  ollama pull gpt-oss:20b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=gpt-oss:20b

# 3) OpenRouter (bepul modellar):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-oss-20b:free

# gpt-oss uchun fikrlash darajasi: low (tezroq) / medium / high. Bo'sh — provayder standarti (medium)
# LLM_REASONING_EFFORT=

# --- Embedding (lokal, bepul, ko'p tilli) ---
EMBED_MODEL=BAAI/bge-m3
# Yengilroq va tezroq (sifati biroz past); e5 modellariga prefikslar ham kerak.
# Modelni almashtirgandan keyin hujjatlarni qayta yuklang.
# EMBED_MODEL=intfloat/multilingual-e5-base
# EMBED_QUERY_PREFIX="query: "
# EMBED_PASSAGE_PREFIX="passage: "

# Modellar qurilmasi: bo'sh — GPU bo'lsa GPU. DEVICE=cpu — video xotira bo'sh qoladi (o'yin paytida), lekin sekinroq
# DEVICE=

# --- Internetga chiqarish (qonunnoma.uz, DEPLOY.md) ---
# Qo'yilsa, ommaviy rejim: hujjat yuklash/o'chirish va /docs faqat shu token bilan; chatga limit
# ADMIN_TOKEN=uzun-tasodifiy-satr
# CHAT_PER_MINUTE=5
# CHAT_PER_DAY=40

# --- Qayta tartiblash (reranker) ---
# Topilgan bo'laklarni savol bilan birga o'qib, eng moslarini tanlaydi. GPU'da tez,
# CPU'da har bir savolga ~10 s qo'shadi — GPU bo'lmasa o'chiring: RERANK_MODEL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- RAG sozlamalari ---
CHUNK_CHARS=1200
CHUNK_OVERLAP=200
TOP_K=8
